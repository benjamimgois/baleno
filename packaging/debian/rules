#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	python3 scripts/bundle-monolith.py

override_dh_auto_install:
	# Install bundled monolith
	install -Dm755 dist/baleno debian/baleno/usr/bin/baleno

	# Install SVG icon (scalable)
	install -Dm644 assets/icons/baleno_icon.svg debian/baleno/usr/share/icons/hicolor/scalable/apps/baleno.svg
	# Install pre-built PNG sizes
	for size in 16 32 48 64 128 256 512; do \
		install -Dm644 assets/icons/baleno-$${size}.png \
			debian/baleno/usr/share/icons/hicolor/$${size}x$${size}/apps/baleno.png; \
	done

	# Install author photo for About dialog
	install -Dm644 assets/photo.png debian/baleno/usr/share/baleno/photo.png

	# Install UI icons (sidebar and misc) — all SVGs
	for icon in assets/icons/*.svg; do \
		install -Dm644 "$$icon" "debian/baleno/usr/share/baleno/icons/$$(basename $$icon)"; \
	done

	# Install vendor icons
	install -Dm644 assets/vendors/default.svg debian/baleno/usr/share/baleno/vendors/default.svg
	install -Dm644 assets/vendors/cisco.svg debian/baleno/usr/share/baleno/vendors/cisco.svg
	install -Dm644 assets/vendors/huawei.svg debian/baleno/usr/share/baleno/vendors/huawei.svg
	install -Dm644 assets/vendors/juniper.svg debian/baleno/usr/share/baleno/vendors/juniper.svg
	install -Dm644 assets/vendors/fortinet.svg debian/baleno/usr/share/baleno/vendors/fortinet.svg
	install -Dm644 assets/vendors/d-link.svg debian/baleno/usr/share/baleno/vendors/d-link.svg
	install -Dm644 assets/vendors/h3c.svg debian/baleno/usr/share/baleno/vendors/h3c.svg
	install -Dm644 assets/vendors/brocade.svg debian/baleno/usr/share/baleno/vendors/brocade.svg
	install -Dm644 assets/vendors/datacom.svg debian/baleno/usr/share/baleno/vendors/datacom.svg
	install -Dm644 assets/vendors/aruba.svg debian/baleno/usr/share/baleno/vendors/aruba.svg
	install -Dm644 assets/vendors/linux.svg debian/baleno/usr/share/baleno/vendors/linux.svg
	install -Dm644 assets/vendors/mikrotik.svg debian/baleno/usr/share/baleno/vendors/mikrotik.svg

	# Install desktop file
	install -Dm644 baleno.desktop debian/baleno/usr/share/applications/baleno.desktop

	# Install documentation
	install -Dm644 README.md debian/baleno/usr/share/doc/baleno/README.md
	install -Dm644 docs/INTERFACE.md debian/baleno/usr/share/doc/baleno/INTERFACE.md
	install -Dm644 LICENSE debian/baleno/usr/share/doc/baleno/copyright
